<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.1.3" />
    <!-- So VideoPlaybackSessionTests runs against the SAME bundled libvlc build the app ships on
         Windows, rather than whatever happens to be installed on the machine. On Linux there is no
         win-x64 native to load and the tests fall back to a system libvlc if one exists, or report
         the unavailable branch. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NPVideoStudio.Domain\NPVideoStudio.Domain.csproj" />
    <ProjectReference Include="..\..\src\NPVideoStudio.Core\NPVideoStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\NPVideoStudio.Infrastructure\NPVideoStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\NPVideoStudio.Media\NPVideoStudio.Media.csproj" />
    <ProjectReference Include="..\..\src\NPVideoStudio.AI\NPVideoStudio.AI.csproj" />
    <ProjectReference Include="..\..\src\NPVideoStudio.Diagnostics\NPVideoStudio.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\NPVideoStudio.App\NPVideoStudio.App.csproj" />
    <ProjectReference Include="..\..\src\NPVideoStudio.Installer\NPVideoStudio.Installer.csproj" />
    <ProjectReference Include="..\FakeYtDlp\FakeYtDlp.csproj" />
    <ProjectReference Include="..\FakeFpcalc\FakeFpcalc.csproj" />
    <ProjectReference Include="..\FakeAiWorker\FakeAiWorker.csproj" />
  </ItemGroup>

</Project>
