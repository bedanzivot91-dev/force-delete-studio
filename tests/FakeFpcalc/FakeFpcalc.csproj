<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FakeFpcalc</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Test-only stand-in for the real Chromaprint `fpcalc` CLI, used to exercise
         SongRecognitionService's process orchestration and FingerprintMatcher's comparison logic
         deterministically, without the real (LGPL, separately-installed) tool present - matches the
         same "mock process, not a fake in test code alone" pattern as FakeYtDlp. -->
  </PropertyGroup>

</Project>
