<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Storage Access Framework covers file import (section 18.1); no
         broad MANAGE_EXTERNAL_STORAGE / legacy READ_EXTERNAL_STORAGE is
         requested, per current Play storage policy. -->
    <!-- INTERNET was removed as unused, then re-added here: the "Suno
         nalog" screen (SunoConnectScreen/SunoApiClient) now genuinely
         logs in via an embedded WebView and calls the real Suno API, so
         this permission is no longer speculative. POST_NOTIFICATIONS and
         FOREGROUND_SERVICE(_MEDIA_PLAYBACK) stay removed, verified by
         grep: still no NotificationManager or MediaSession/
         PlaybackService anywhere in app/src, unlike RECORD_AUDIO and
         INTERNET which real screens now use. Re-add each one only when
         the feature that needs it actually lands. -->

    <application
        android:name=".SunoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.SunoPesmeStudio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SunoPesmeStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
