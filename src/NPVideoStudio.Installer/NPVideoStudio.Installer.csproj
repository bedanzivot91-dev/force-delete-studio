<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NPVideoStudioSetup</AssemblyName>
    <RootNamespace>NPVideoStudio.Installer</RootNamespace>
    <!-- Registry/shortcut/process APIs used here only ever run on Windows (this whole app is
         Windows-only, see CLAUDE.md) - suppress the cross-platform-analyzer warnings rather than
         guard every call with OperatingSystem.IsWindows(), which would be noise here. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

</Project>
