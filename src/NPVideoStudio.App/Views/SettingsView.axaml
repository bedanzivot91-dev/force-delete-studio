<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             xmlns:conv="using:NPVideoStudio.App.Converters"
             x:Class="NPVideoStudio.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" Spacing="18" MaxWidth="660" HorizontalAlignment="Left">
      <StackPanel Spacing="2">
        <TextBlock Text="PODEŠAVANJA" Classes="eyebrow" />
        <TextBlock Text="Prilagodi program" Classes="heading" />
      </StackPanel>

      <Border Classes="panel" Padding="24">
        <StackPanel Spacing="18">
          <StackPanel Spacing="6">
            <TextBlock Text="Tema" Classes="subtle" />
            <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:Object">
                  <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="subtle" TextWrapping="Wrap"
                       Text="Trenutno su dostupne 3 od planiranih 10 tema. Ostale dolaze u narednim fazama." />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Folder za projekte" Classes="subtle" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding ProjectsFolder}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Izaberi..." Command="{Binding BrowseProjectsFolderCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Cache folder" Classes="subtle" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding CacheFolder}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Izaberi..." Command="{Binding BrowseCacheFolderCommand}" />
            </Grid>
          </StackPanel>

          <CheckBox IsChecked="{Binding AutoSaveEnabled}" Content="Automatsko čuvanje uključeno" />

          <StackPanel Spacing="6">
            <TextBlock Text="Interval automatskog čuvanja (sekunde)" Classes="subtle" />
            <NumericUpDown Value="{Binding AutoSaveIntervalSeconds}" Minimum="10" Maximum="3600" Width="170" HorizontalAlignment="Left" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Čuvanje logova (dana)" Classes="subtle" />
            <NumericUpDown Value="{Binding LogRetentionDays}" Minimum="1" Maximum="365" Width="170" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Alati" Classes="section" />
      <Border Classes="panel" Padding="24">
        <StackPanel Spacing="18">
          <TextBlock Classes="subtle" TextWrapping="Wrap"
                     Text="Ostavite prazno da program sam pronađe alat (pored programa ili u PATH-u). Stvarno stanje svakog alata proverite na ekranu „Alati i modeli“. Izmena ovde važi tek posle ponovnog pokretanja programa." />

          <StackPanel Spacing="6">
            <TextBlock Text="FFmpeg putanja" Classes="subtle" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding FfmpegPath}" Watermark="Automatski pronađi" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Izaberi..." Command="{Binding BrowseFfmpegPathCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="FFprobe putanja" Classes="subtle" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding FfprobePath}" Watermark="Automatski pronađi" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Izaberi..." Command="{Binding BrowseFfprobePathCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="yt-dlp putanja" Classes="subtle" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding YtDlpPath}" Watermark="Automatski pronađi" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Izaberi..." Command="{Binding BrowseYtDlpPathCommand}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}" Classes="subtle" IsVisible="{Binding HasStatusMessage}" />

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="cta" Content="Sačuvaj podešavanja" Command="{Binding SaveCommand}" />
        <Button Classes="ghost" Content="Vrati podrazumevano" Command="{Binding ResetToDefaultsCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
