<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             x:Class="NPVideoStudio.App.Views.ModernWorkspaceHeaderView"
             x:DataType="vm:WorkspaceViewModel">
  <Grid ColumnDefinitions="*,Auto" Margin="2,0">
    <StackPanel Spacing="3" VerticalAlignment="Center">
      <TextBlock Text="{Binding Project.Name}" FontSize="20" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Background="{DynamicResource ThemeAccentSubtleBrush}" CornerRadius="999" Padding="8,3">
          <TextBlock Text="{Binding FormatSummaryLabel}" FontSize="12.5" Foreground="{DynamicResource ThemeAccentBrush}" />
        </Border>
        <TextBlock Text="{Binding StatusMessage}" Classes="subtle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button Classes="ghost" Content="Sačuvaj" Command="{Binding SaveProjectCommand}" ToolTip.Tip="Ctrl+S" />
      <Button Classes="ghost" Content="Dodaj medije" Command="{Binding ImportMediaCommand}" />
      <Button Classes="cta" Content="Izvezi video" Command="{Binding ExportVideoCommand}" />
    </StackPanel>
  </Grid>
</UserControl>