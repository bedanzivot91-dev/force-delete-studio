<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NPVideoStudio.App.ViewModels"
        xmlns:views="using:NPVideoStudio.App.Views"
        x:Class="NPVideoStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NP Video Studio"
        Width="1400" Height="900" MinWidth="1024" MinHeight="640">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:StartScreenViewModel">
      <views:StartScreenView />
    </DataTemplate>
    <DataTemplate DataType="vm:NewProjectViewModel">
      <views:NewProjectView />
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspaceViewModel">
      <views:WorkspaceView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:DiagnosticsViewModel">
      <views:DiagnosticsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SongHighlightsViewModel">
      <views:SongHighlightsView />
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="surface" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource ThemeAccentBrush}">
            <TextBlock Text="NP" FontSize="12" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="NP VIDEO STUDIO" FontWeight="SemiBold" FontSize="15" LetterSpacing="0.5" VerticalAlignment="Center" />
          <Button Classes="ghost" Content="Početni ekran" Command="{Binding GoHomeCommand}" Margin="12,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="Podešavanja" Command="{Binding GoToSettingsCommand}" />
          <Button Classes="ghost" Content="Dijagnostika" Command="{Binding GoToDiagnosticsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Content="{Binding CurrentPage}" />
  </DockPanel>
</Window>
