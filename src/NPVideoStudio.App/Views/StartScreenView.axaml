<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             x:Class="NPVideoStudio.App.Views.StartScreenView"
             x:DataType="vm:StartScreenViewModel">

  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" Spacing="24" MaxWidth="1180" HorizontalAlignment="Stretch">

      <StackPanel Spacing="2">
        <TextBlock Text="DOBRODOŠLI" Classes="eyebrow" />
        <TextBlock Text="Šta pravimo danas?" Classes="heading" />
      </StackPanel>

      <Border Classes="panel" Padding="18" IsVisible="{Binding HasRecoveryMessage}"
              Background="{DynamicResource ThemeAccentSubtleBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding RecoveryMessage}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="cta" Content="Nastavi od automatskog čuvanja" Command="{Binding RecoverAutoSaveCommand}" />
            <Button Classes="ghost" Content="Zanemari" Command="{Binding DismissRecoveryCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Novi projekat" Classes="section" />
      <WrapPanel>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding NewProjectCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="+" /></Border>
            <TextBlock Text="Novi projekat" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="Izaberite format ručno" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenProjectCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="📂" /></Border>
            <TextBlock Text="Otvori projekat" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="Iz .npvsproject fajla" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding NewYouTubeVideoCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="▶" /></Border>
            <TextBlock Text="YouTube video" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="16:9 · 1920x1080 · 30 fps" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding NewYouTubeShortsCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="⚡" /></Border>
            <TextBlock Text="YouTube Shorts" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="9:16 · 1080x1920 · 30 fps" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding NewTikTokCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="♪" /></Border>
            <TextBlock Text="TikTok video" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="9:16 · 1080x1920 · 30 fps" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding NewInstagramReelCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="◎" /></Border>
            <TextBlock Text="Instagram Reel" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="9:16 · 1080x1920 · 30 fps" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding NewFacebookReelCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="f" FontWeight="Bold" /></Border>
            <TextBlock Text="Facebook Reel" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="9:16 · 1080x1920 · 30 fps" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <TextBlock Text="Alati" Classes="section" />
      <WrapPanel>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenSongHighlightsCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="✂" /></Border>
            <TextBlock Text="Isečci iz pesme" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="3 najglasnija dela pesme za Shorts najavu" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenLyricSearchCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="🔍" /></Border>
            <TextBlock Text="Pronađi tekst u pesmi" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="Ukucaj stih, program ga nađe u pesmi (lokalni Whisper)" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenYouTubeDownloadCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="⬇" /></Border>
            <TextBlock Text="Preuzmi sa YouTube-a" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="Preuzmi kompletnu pesmu sa svog kanala" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenSubtitleGeneratorCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="💬" /></Border>
            <TextBlock Text="Generiši titlove (SRT)" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="Automatski titlovi iz govora/pevanja (lokalni Whisper)" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenMySongsCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="🎵" /></Border>
            <TextBlock Text="Moje pesme" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="Biblioteka pesama sa prepoznavanjem otiska (fingerprint)" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenCaptionEditorCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="📝" /></Border>
            <TextBlock Text="Uređivač titlova" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="Uređivanje na nivou reči, undo/redo, SRT/VTT/ASS/TXT/JSON/LRC" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <TextBlock Text="Nedavni projekti" Classes="section" />
      <Border Classes="panel" Padding="20" IsVisible="{Binding !HasRecentProjects}">
        <TextBlock Classes="subtle" Text="Još nema nedavnih projekata. Napravite novi ili otvorite postojeći iznad." />
      </Border>
      <ItemsControl ItemsSource="{Binding RecentProjects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecentProjectItemViewModel">
            <Border Classes="panel" Padding="16,14" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
                  <TextBlock Classes="subtle" Text="{Binding AspectRatioLabel}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                           Text="Fajl nije pronađen" IsVisible="{Binding IsMissing}" Foreground="#E06060" FontSize="12.5" />
                <Button Grid.Column="2" Classes="cta" Content="Otvori" Margin="8,0" Padding="14,8"
                        Command="{Binding OpenCommand}" IsEnabled="{Binding !IsMissing}" />
                <Button Grid.Column="3" Classes="ghost" Content="Ukloni" Command="{Binding RemoveCommand}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Ostale funkcije" Classes="section" />
      <WrapPanel>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenSettingsCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="⚙" /></Border>
            <TextBlock Text="Podešavanja" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenDiagnosticsCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="✓" /></Border>
            <TextBlock Text="Dijagnostika sistema" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Width="216" Margin="0,0,14,14" Command="{Binding OpenDependencyManagerCommand}">
          <StackPanel Spacing="2">
            <Border Classes="iconBadge"><TextBlock Text="🧩" /></Border>
            <TextBlock Text="Alati i modeli" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding PlannedFeatures}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Classes="tile" Width="216" Margin="0,0,14,14" IsEnabled="False">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                  <TextBlock Classes="subtle" Text="Uskoro — u razvoju" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
