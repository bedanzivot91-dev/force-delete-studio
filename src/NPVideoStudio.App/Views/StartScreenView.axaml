<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             x:Class="NPVideoStudio.App.Views.StartScreenView"
             x:DataType="vm:StartScreenViewModel">
  <ScrollViewer>
    <StackPanel Margin="34,30,34,40" Spacing="24" MaxWidth="1220" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="NP VIDEO STUDIO" Classes="eyebrow" />
          <TextBlock Text="Kreiraj brže. Sve je tamo gde očekuješ." Classes="heading" />
          <TextBlock Text="Izaberi projekat ili workflow. Napredni alati su grupisani po poslu koji želiš da završiš." Classes="subtle" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Classes="inspectorSection" Padding="12,8" VerticalAlignment="Center">
          <TextBlock Text="STUDIO 2026" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" />
        </Border>
      </Grid>

      <Border Classes="panel" Padding="18" IsVisible="{Binding HasRecoveryMessage}"
              Background="{DynamicResource ThemeAccentSubtleBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Automatski sačuvan rad je pronađen" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RecoveryMessage}" Classes="subtle" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="cta" Content="Nastavi rad" Command="{Binding RecoverAutoSaveCommand}" />
            <Button Classes="ghost" Content="Zanemari" Command="{Binding DismissRecoveryCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="panel" Padding="20">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Text="PROJEKTI I FORMATI" Classes="eyebrow" />
            <TextBlock Text="Počni od pravog platna" Classes="section" />
          </StackPanel>
          <WrapPanel>
            <Button Classes="tile" Width="220" Margin="0,0,12,12" Command="{Binding NewProjectCommand}">
              <StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="+" /></Border><TextBlock Text="Novi projekat" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Ručno izaberi format i FPS" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Classes="tile" Width="220" Margin="0,0,12,12" Command="{Binding OpenProjectCommand}">
              <StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="📂" /></Border><TextBlock Text="Otvori projekat" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Nastavi postojeći .npvsproject" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Classes="tile" Width="220" Margin="0,0,12,12" Command="{Binding NewYouTubeVideoCommand}">
              <StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="▶" /></Border><TextBlock Text="YouTube 16:9" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="1920×1080 · 30 fps"/></StackPanel>
            </Button>
            <Button Classes="tile" Width="220" Margin="0,0,12,12" Command="{Binding NewYouTubeShortsCommand}">
              <StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="⚡" /></Border><TextBlock Text="YouTube Shorts" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="1080×1920 · 30 fps"/></StackPanel>
            </Button>
            <Button Classes="tile" Width="220" Margin="0,0,12,12" Command="{Binding NewTikTokCommand}">
              <StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="♪" /></Border><TextBlock Text="TikTok" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="9:16 · 1080×1920"/></StackPanel>
            </Button>
            <Button Classes="tile" Width="220" Margin="0,0,12,12" Command="{Binding NewInstagramReelCommand}">
              <StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="◎" /></Border><TextBlock Text="Instagram Reel" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="9:16 · 1080×1920"/></StackPanel>
            </Button>
            <Button Classes="tile" Width="220" Margin="0,0,12,12" Command="{Binding NewFacebookReelCommand}">
              <StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="f" FontWeight="Bold" /></Border><TextBlock Text="Facebook Reel" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="9:16 · 1080×1920"/></StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*">
        <Border Grid.Column="0" Classes="panel" Padding="20" Margin="0,0,8,0">
          <StackPanel Spacing="14">
            <StackPanel Spacing="2"><TextBlock Text="TEKST, TITLOVI I AI" Classes="eyebrow"/><TextBlock Text="Sve za tekst u videu" Classes="section"/></StackPanel>
            <WrapPanel>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding AddTextToVideoCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="T"/></Border><TextBlock Text="Dodaj tekst u video" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Font, boja, položaj i stil" TextWrapping="Wrap"/></StackPanel></Button>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding OpenSubtitleGeneratorCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="CC" FontSize="12.5"/></Border><TextBlock Text="Automatski titlovi" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Whisper → SRT i uređivi tekst" TextWrapping="Wrap"/></StackPanel></Button>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding OpenCaptionEditorCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="✎"/></Border><TextBlock Text="Uređivač titlova" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Reči, tajming, undo/redo, export" TextWrapping="Wrap"/></StackPanel></Button>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding OpenCaptionStyleGalleryCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="Aa" FontSize="12.5"/></Border><TextBlock Text="Stilovi titlova" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Gotovi vizuelni stilovi" TextWrapping="Wrap"/></StackPanel></Button>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding OpenLyricSearchCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="⌕"/></Border><TextBlock Text="Pronađi stih u pesmi" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Lokalni Whisper pretražuje audio" TextWrapping="Wrap"/></StackPanel></Button>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding OpenVideoLayoutAnalyzerCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="▦"/></Border><TextBlock Text="Analiza rasporeda" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="OCR otkriva postojeći tekst u kadru" TextWrapping="Wrap"/></StackPanel></Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="panel" Padding="20" Margin="8,0,0,0">
          <StackPanel Spacing="14">
            <StackPanel Spacing="2"><TextBlock Text="PESME I YOUTUBE" Classes="eyebrow"/><TextBlock Text="Audio i kanal workflow" Classes="section"/></StackPanel>
            <WrapPanel>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding OpenMySongsCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="♫"/></Border><TextBlock Text="Moje pesme" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Biblioteka i fingerprint prepoznavanje" TextWrapping="Wrap"/></StackPanel></Button>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding OpenSongHighlightsCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="✂"/></Border><TextBlock Text="Isečci iz pesme" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Najbolji delovi za Shorts najavu" TextWrapping="Wrap"/></StackPanel></Button>
              <Button Classes="tile" Width="220" Margin="0,0,10,10" Command="{Binding OpenYouTubeDownloadCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="↓"/></Border><TextBlock Text="Preuzmi sa YouTube-a" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Preuzimanje sopstvenog sadržaja" TextWrapping="Wrap"/></StackPanel></Button>
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="panel" Padding="20">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2"><TextBlock Text="BRZI WORKFLOW I ŠABLONI" Classes="eyebrow"/><TextBlock Text="Manje koraka do gotovog videa" Classes="section"/></StackPanel>
          <WrapPanel>
            <Button Classes="tile" Width="250" Margin="0,0,12,12" Command="{Binding OpenTemplateGalleryCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="▦"/></Border><TextBlock Text="Video iz šablona" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Projekat sa unapred pripremljenim trakama" TextWrapping="Wrap"/></StackPanel></Button>
            <Button Classes="tile" Width="250" Margin="0,0,12,12" Command="{Binding OpenQuickVideoCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="▣"/></Border><TextBlock Text="Slika + pesma" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Brzi video bez ručnog slaganja timeline-a" TextWrapping="Wrap"/></StackPanel></Button>
            <Button Classes="tile" Width="250" Margin="0,0,12,12" Command="{Binding OpenQuickVideoWithCaptionsCommand}"><StackPanel Spacing="4"><Border Classes="iconBadge"><TextBlock Text="CC" FontSize="12.5"/></Border><TextBlock Text="Slika + pesma + titlovi" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="Automatski video sa utisnutim titlovima" TextWrapping="Wrap"/></StackPanel></Button>
          </WrapPanel>
        </StackPanel>
      </Border>

      <StackPanel Spacing="12">
        <StackPanel Spacing="2"><TextBlock Text="NEDAVNI PROJEKTI" Classes="eyebrow"/><TextBlock Text="Nastavi gde si stao" Classes="section"/></StackPanel>
        <Border Classes="panel" Padding="20" IsVisible="{Binding !HasRecentProjects}"><TextBlock Classes="subtle" Text="Još nema nedavnih projekata." /></Border>
        <ItemsControl ItemsSource="{Binding RecentProjects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectItemViewModel">
              <Border Classes="panel" Padding="16,14" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <StackPanel Spacing="2"><TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"/><TextBlock Classes="subtle" Text="{Binding AspectRatioLabel}"/></StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Text="Fajl nije pronađen" IsVisible="{Binding IsMissing}" Foreground="{DynamicResource ThemeDangerBrush}" FontSize="12.5"/>
                  <Button Grid.Column="2" Classes="cta" Content="Otvori" Margin="8,0" Command="{Binding OpenCommand}" IsEnabled="{Binding !IsMissing}"/>
                  <Button Grid.Column="3" Classes="ghost" Content="Ukloni" Command="{Binding RemoveCommand}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border Classes="panel" Padding="20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2"><TextBlock Text="SISTEM" Classes="eyebrow"/><TextBlock Text="Podešavanja i ugrađeni alati" Classes="section"/><TextBlock Text="Ove funkcije ne pripadaju kreativnom workflow-u, zato su odvojene od editora." Classes="subtle"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="ghost" Content="Podešavanja" Command="{Binding OpenSettingsCommand}"/>
            <Button Classes="ghost" Content="Dijagnostika" Command="{Binding OpenDiagnosticsCommand}"/>
            <Button Classes="cta" Content="Alati i modeli" Command="{Binding OpenDependencyManagerCommand}"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>