<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="NPVideoStudio.App.Views.DependencyManagerView"
             x:DataType="vm:DependencyManagerViewModel">

  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" Spacing="18" MaxWidth="820">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="SISTEM" Classes="eyebrow" />
          <TextBlock Text="Alati i modeli" Classes="heading" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Content="Proveri ponovo" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsLoading}" VerticalAlignment="Bottom" />
      </Grid>

      <TextBlock Classes="subtle" TextWrapping="Wrap"
                 Text="Stvarno stanje alata koje program koristi — provera pokreće pravi alat/modul, čita njegovu verziju i proverava kompatibilnost. Postojeći fajl koji ne može da se pokrene prijavljuje se kao neispravan, ne kao uspešno instaliran." />

      <TextBlock Text="{Binding StatusMessage}" Classes="subtle" TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

      <ItemsControl ItemsSource="{Binding Dependencies}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DependencyItemViewModel">
            <Border Classes="panel" Padding="18" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel Margin="0,4,14,0" VerticalAlignment="Top">
                  <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource ThemeAccentBrush}" IsVisible="{Binding IsInstalled}" />
                  <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource ThemeDangerBrush}" IsVisible="{Binding NeedsAttention}" />
                </Panel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <Border Classes="panel" Padding="8,2" CornerRadius="10">
                      <TextBlock Text="{Binding StatusLabel}" FontSize="12" Classes="subtle" />
                    </Border>
                    <TextBlock Text="{Binding VersionLabel}" Classes="subtle" FontSize="12"
                               IsVisible="{Binding VersionLabel, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <TextBlock Text="{Binding WhyItMatters}" Classes="subtle" TextWrapping="Wrap" />
                  <WrapPanel>
                    <TextBlock Text="{Binding ExpectedVersionLabel}" Classes="subtle" FontSize="11" Margin="0,0,12,0"
                               IsVisible="{Binding ExpectedVersionLabel, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding LicenseLabel}" Classes="subtle" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding LicenseLabel, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding TechnicalDetails}" Classes="subtle" FontSize="11" TextWrapping="Wrap"
                             IsVisible="{Binding TechnicalDetails, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="{Binding LastCheckedLabel}" Classes="subtle" FontSize="10.5" />
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Content="Otvori folder" Command="{Binding OpenFolderCommand}"
                        IsVisible="{Binding CanOpenFolder}" VerticalAlignment="Top" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="panel" Padding="20" IsVisible="{Binding HasMissingSongAi}"
              Background="{DynamicResource ThemeAccentSubtleBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="AI za prepoznavanje stihova pesme nije spreman" FontWeight="SemiBold" />
          <TextBlock Classes="subtle" TextWrapping="Wrap"
                     Text="Program instalira ili popravlja svoje zasebno Python 3.12 okruženje, faster-whisper, Demucs, lyric-align i OpenCV/CSRT. Potrebno je najmanje 8 GB slobodnog prostora." />
          <Button Classes="cta" Content="INSTALIRAJ / POPRAVI AI ZA PESME" Command="{Binding InstallSongAiCommand}"
                  IsEnabled="{Binding !IsDownloadingModel}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="20">
        <StackPanel Spacing="10">
          <TextBlock Text="Instalacija i ažuriranje AI alata" FontWeight="SemiBold" />
          <TextBlock Classes="subtle" TextWrapping="Wrap"
                     Text="Menja samo NP Video Studio AI okruženje. Ne ažurira Windows niti sistemske kopije FFmpeg-a, yt-dlp-a ili drugih programa. Posle instalacije svaki obavezni modul se ponovo stvarno proverava." />
          <Button Classes="cta" Content="INSTALIRAJ / AŽURIRAJ SVE AI ALATE" Command="{Binding InstallSongAiCommand}"
                  IsEnabled="{Binding !IsDownloadingModel}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding ModelStatusMessage}" Classes="subtle" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="20" IsVisible="{Binding HasDownloadableWhisperModel}"
              Background="{DynamicResource ThemeAccentSubtleBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Whisper model nije spreman" FontWeight="SemiBold" />
          <TextBlock Classes="subtle" Text="{Binding ModelStatusMessage}" TextWrapping="Wrap"
                     IsVisible="{Binding ModelStatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="cta" Content="Preuzmi / popravi model" Command="{Binding DownloadWhisperModelCommand}"
                    IsEnabled="{Binding !IsDownloadingModel}" />
            <Button Classes="ghost" Content="Otkaži" Command="{Binding CancelDownloadCommand}"
                    IsVisible="{Binding IsDownloadingModel}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
