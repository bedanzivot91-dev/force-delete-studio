<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             xmlns:conv="using:NPVideoStudio.App.Converters"
             x:Class="NPVideoStudio.App.Views.NewProjectView"
             x:DataType="vm:NewProjectViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
      <TextBlock Text="Novi projekat" FontSize="22" FontWeight="Bold" />

      <StackPanel Spacing="6">
        <TextBlock Text="Naziv projekta" />
        <TextBox Text="{Binding ProjectName}" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Format (odnos stranica)" />
        <ComboBox ItemsSource="{Binding AspectRatioOptions}" SelectedItem="{Binding SelectedAspectRatio}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:Object">
              <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Rezolucija" />
        <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:Object">
              <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsCustomResolution}">
        <TextBlock Text="Ručna rezolucija (širina x visina)" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <NumericUpDown Value="{Binding CustomWidth}" Minimum="16" Maximum="7680" Width="140" />
          <TextBlock Text="x" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding CustomHeight}" Minimum="16" Maximum="7680" Width="140" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Frame rate" />
        <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding SelectedFrameRate}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:Object">
              <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsCustomFrameRate}">
        <TextBlock Text="Ručni FPS" />
        <NumericUpDown Value="{Binding CustomFps}" Minimum="1" Maximum="240" Width="140" />
      </StackPanel>

      <Border Classes="panel" Padding="12">
        <TextBlock Text="{Binding PreviewLabel}" FontWeight="Bold" />
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="OrangeRed" IsVisible="{Binding HasErrorMessage}" TextWrapping="Wrap" />

      <Button Classes="accent" Content="Napravi projekat" Command="{Binding CreateCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
