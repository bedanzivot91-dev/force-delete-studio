<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             x:Class="NPVideoStudio.App.Views.RenderQueueView"
             x:DataType="vm:RenderQueueViewModel">

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="surface" Padding="24,16" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Izvoz videa" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="ghost" Content="← Nazad na projekat" Command="{Binding BackCommand}" />
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="24" Spacing="20" MaxWidth="900">
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="Podešavanja izvoza" FontWeight="SemiBold" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Izlazni fajl:" VerticalAlignment="Center" Width="140" />
              <TextBox Text="{Binding OutputFilePath}" Width="440" />
              <Button Classes="ghost" Content="Izaberi fajl" Command="{Binding PickOutputFileCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Kodek:" VerticalAlignment="Center" Width="140" />
              <ComboBox ItemsSource="{Binding CodecOptions}" SelectedItem="{Binding SelectedCodecOption}" Width="320">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CodecOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Preset (brzina/kvalitet):" VerticalAlignment="Center" Width="140" />
              <ComboBox ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding Preset}" Width="200" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="CRF (kvalitet):" VerticalAlignment="Center" Width="140" />
              <NumericUpDown Value="{Binding Crf}" Minimum="0" Maximum="51" Width="160" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Audio bitrate (kbps):" VerticalAlignment="Center" Width="140" />
              <NumericUpDown Value="{Binding AudioBitrateKbps}" Minimum="64" Maximum="320" Increment="32" Width="160" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <TextBlock Text="{Binding StatusMessage}" Classes="subtle" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" />
              <Button Classes="cta" Content="Pokreni izvoz" Command="{Binding StartRenderCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Text="Red za izvoz" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="Nema pokrenutih izvoza." IsVisible="{Binding !Jobs.Count}" />

            <ItemsControl ItemsSource="{Binding Jobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RenderJobItemViewModel">
                  <Border Classes="panel" Padding="14" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding OutputFilePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding StatusLabel}" Classes="subtle" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="12,0" />
                        <Button Grid.Column="2" Classes="ghost" Content="Otkaži" Command="{Binding CancelCommand}" />
                      </Grid>
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" />
                      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
