<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="NPVideoStudio.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="900">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="Dijagnostika sistema" FontSize="22" FontWeight="Bold" />
        <Button Grid.Column="1" Content="Pokreni ponovo" Command="{Binding RunChecksCommand}" Margin="8,0" />
        <Button Grid.Column="2" Classes="accent" Content="Napravi paket za podršku" Command="{Binding CreateSupportPackageCommand}" />
      </Grid>

      <TextBlock Text="Program se ne oslanja na tvrdnje - svaka stavka ispod je stvarno provereno na ovom računaru." Classes="subtle" TextWrapping="Wrap" />

      <TextBlock Text="{Binding StatusMessage}" Foreground="OrangeRed" IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Checks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DiagnosticCheckItemViewModel">
            <Border Classes="panel" Padding="14" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold" FontSize="16" Margin="0,0,10,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Result.CheckName}" FontWeight="Bold" />
                  <Button Grid.Column="2" Content="Pokušaj automatsku popravku" Command="{Binding AutoFixCommand}"
                          IsVisible="{Binding CanAutoFix}" IsEnabled="{Binding !IsFixing}" />
                </Grid>
                <TextBlock Text="{Binding Result.Description}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Result.WhyItMatters}" Classes="subtle" TextWrapping="Wrap"
                           IsVisible="{Binding Result.WhyItMatters, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Result.HowToFix}" Classes="subtle" TextWrapping="Wrap" FontStyle="Italic"
                           IsVisible="{Binding Result.HowToFix, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <Expander Header="Tehnički detalji" IsVisible="{Binding Result.TechnicalDetails, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <TextBox Text="{Binding Result.TechnicalDetails}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
