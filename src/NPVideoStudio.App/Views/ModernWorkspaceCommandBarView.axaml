<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="NPVideoStudio.App.Views.ModernWorkspaceCommandBarView"
             x:DataType="vm:WorkspaceViewModel">
  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
    <Border Classes="inspectorSection" Padding="10,7" Margin="0,0,12,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Titlovi" Classes="eyebrow" VerticalAlignment="Center" />
        <Button Classes="cta" Content="Automatski tekst" Command="{Binding GenerateCaptionsForVideoCommand}" IsEnabled="{Binding !IsGeneratingCaptions}"
                ToolTip.Tip="Prepoznaje govor/pesmu i dodaje uređive titlove na timeline." />
        <Button Classes="ghost" Content="Karaoke" Command="{Binding GenerateKaraokeCaptionsForVideoCommand}" IsEnabled="{Binding !IsGeneratingCaptions}" />
        <Button Classes="ghost" Content="Stilovi titla" Command="{Binding OpenCaptionStyleGalleryCommand}"
                ToolTip.Tip="Izaberi tekst/titl klip na timeline-u i primeni stil koji se čuva u projektu i ulazi u export." />
        <Button Classes="ghost" Content="Prekini" Command="{Binding CancelCaptionGenerationCommand}" IsVisible="{Binding IsGeneratingCaptions}" />
      </StackPanel>
    </Border>

    <Expander Grid.Column="1" Header="Tačan tekst pesme" VerticalAlignment="Center" Margin="0,0,12,0">
      <Border Classes="inspectorSection" Padding="12" MinWidth="420">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Content="Učitaj TXT / RTF" Command="{Binding LoadVerifiedLyricsCommand}" />
            <TextBlock Text="{Binding VerifiedLyricsFileName}" Classes="subtle" VerticalAlignment="Center" />
          </StackPanel>
          <TextBox Text="{Binding VerifiedLyricsText}" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                   Watermark="Nalepi kompletan tačan tekst pesme, red po red..." />
          <Button Classes="cta" Content="Sinhronizuj sa pesmom" HorizontalAlignment="Left"
                  Command="{Binding SyncVerifiedLyricsCommand}" IsEnabled="{Binding !IsGeneratingCaptions}" />
        </StackPanel>
      </Border>
    </Expander>

    <Expander Grid.Column="2" Header="Scene / Auto Cut" VerticalAlignment="Center" Margin="0,0,12,0">
      <Border Classes="inspectorSection" Padding="12" MinWidth="320">
        <StackPanel Spacing="8">
          <TextBlock Text="Izaberi video klip. FFmpeg analizira samo njegov Trim In/Out opseg i pravi rezove na stvarnim promenama scene."
                     Classes="subtle" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*">
            <StackPanel Spacing="4">
              <TextBlock Text="Prag scene (%)" Classes="subtle" />
              <NumericUpDown Value="{Binding SceneDetectionThresholdPercent}" Minimum="0.1" Maximum="100" Increment="1" FormatString="0.0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
              <TextBlock Text="Min. razmak (s)" Classes="subtle" />
              <NumericUpDown Value="{Binding SceneMinimumSpacingSeconds}" Minimum="0.05" Maximum="10" Increment="0.05" FormatString="0.00" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="cta" Content="Pronađi scene i iseci" Command="{Binding AutoCutSelectedClipCommand}" IsEnabled="{Binding !IsDetectingScenes}" />
            <Button Classes="ghost" Content="Prekini" Command="{Binding CancelSceneDetectionCommand}" IsVisible="{Binding IsDetectingScenes}" />
          </StackPanel>
          <TextBlock Text="{Binding SceneDetectionStatusMessage}" Classes="subtle" TextWrapping="Wrap"
                     IsVisible="{Binding SceneDetectionStatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>
    </Expander>

    <TextBlock Grid.Column="3" Text="{Binding CaptionsStatusMessage}" Classes="subtle" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
               IsVisible="{Binding CaptionsStatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

    <Border Grid.Column="4" Classes="inspectorSection" Padding="10,7">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Pregled" Classes="eyebrow" VerticalAlignment="Center" />
        <Button Classes="ghost" Content="15 s oko plejheda" Command="{Binding RenderRealPreviewAroundPlayheadCommand}" IsEnabled="{Binding !IsRenderingRealPreview}" />
        <Button Classes="ghost" Content="Cela traka" Command="{Binding RenderRealPreviewCommand}" IsEnabled="{Binding !IsRenderingRealPreview}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
