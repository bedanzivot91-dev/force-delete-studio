<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             xmlns:dom="using:NPVideoStudio.Domain"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="NPVideoStudio.App.Views.MySongsView"
             x:DataType="vm:MySongsViewModel">

  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" Spacing="18" MaxWidth="900">
      <StackPanel Spacing="2">
        <TextBlock Text="BIBLIOTEKA" Classes="eyebrow" />
        <TextBlock Text="Moje pesme" Classes="heading" />
      </StackPanel>

      <TextBlock Classes="subtle" TextWrapping="Wrap"
                 Text="Lokalna biblioteka vaših pesama sa otiskom (fingerprint) pesme - kada ponovo uvezete istu pesmu (npr. novo preuzimanje sa YouTube-a), program prepoznaje da li je već ovde, umesto da traži tekst i verifikaciju iznova." />

      <Border Classes="panel" Padding="20">
        <StackPanel Spacing="14">
          <Button Classes="cta" Content="Uvezi pesmu..." Command="{Binding ImportCommand}"
                  IsEnabled="{Binding !IsImporting}" HorizontalAlignment="Left" />

          <StackPanel Spacing="12" IsVisible="{Binding HasPendingImport}">
            <StackPanel Spacing="6">
              <TextBlock Text="Naziv pesme" Classes="subtle" />
              <TextBox Text="{Binding PendingImportTitle}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Izvođač (opciono)" Classes="subtle" />
              <TextBox Text="{Binding PendingImportArtist}" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasDuplicateCandidates}">
              <TextBlock Text="Moguća podudaranja u biblioteci:" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding DuplicateCandidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dom:SongMatchCandidate">
                    <Border Classes="panel" Padding="12" Margin="0,0,0,6">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Classes="subtle"
                                   Text="{Binding Confidence, StringFormat='Poklapanje: {0:P0}, prozora: {1}'}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="cta" Content="Dodaj kao novu pesmu" Command="{Binding ConfirmAddNewCommand}" />
              <Button Classes="ghost" Content="Otkaži" Command="{Binding CancelImportCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}" Classes="subtle" TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

      <StackPanel Spacing="10" IsVisible="{Binding HasSongs}">
        <TextBlock Text="Pesme u biblioteci" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Songs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SongLibraryItemViewModel">
              <Border Classes="panel" Padding="16" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Classes="subtle" Text="{Binding Artist}" IsVisible="{Binding Artist, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="subtle" Text="{Binding DurationLabel, StringFormat='Trajanje: {0}'}" />
                    <TextBlock Classes="subtle" Text="{Binding VerificationStatusLabel, StringFormat='Status: {0}'}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsDeleteFileConfirmationVisible}">
                      <Button Classes="ghost" Content="Ponovo analiziraj" Command="{Binding ReanalyzeCommand}" />
                      <Button Classes="ghost" Content="Obriši samo zapis" Command="{Binding DeleteRecordOnlyCommand}" />
                      <Button Classes="ghost" Content="Obriši zapis i AUDIO FAJL" Command="{Binding DeleteRecordAndFileCommand}" />
                    </StackPanel>
                    <Border Classes="panel" Padding="12" BorderBrush="#E06060" IsVisible="{Binding IsDeleteFileConfirmationVisible}">
                      <StackPanel Spacing="8" MaxWidth="420">
                        <TextBlock Text="Ovo trajno briše originalni audio fajl sa diska. Ovu radnju nije moguće Undo." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="DA, TRAJNO OBRIŠI FAJL" Command="{Binding ConfirmDeleteRecordAndFileCommand}" />
                          <Button Classes="ghost" Content="Otkaži" Command="{Binding CancelDeleteRecordAndFileCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Text="Biblioteka je prazna - uvezite prvu pesmu." Classes="subtle"
                 IsVisible="{Binding !HasSongs}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
